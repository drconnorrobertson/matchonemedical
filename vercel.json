{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/product", "destination": "/dme/", "statusCode": 301 },
    { "source": "/product/", "destination": "/dme/", "statusCode": 301 },
    { "source": "/order-products", "destination": "/dme/", "statusCode": 301 },
    { "source": "/order-products/", "destination": "/dme/", "statusCode": 301 },
    { "source": "/location", "destination": "/contact/", "statusCode": 301 },
    { "source": "/location/", "destination": "/contact/", "statusCode": 301 },
    { "source": "/careers", "destination": "/about/", "statusCode": 301 },
    { "source": "/careers/", "destination": "/about/", "statusCode": 301 },
    { "source": "/login", "destination": "/", "statusCode": 301 },
    { "source": "/login/", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
